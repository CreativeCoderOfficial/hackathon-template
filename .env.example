# Copy to .env.local and fill in. Never commit real values.

# Supabase DEV project URL (Project settings > API).
NEXT_PUBLIC_SUPABASE_URL=your-project-url

# Supabase publishable (anon) key. Safe for the browser, protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Supabase service-role key. SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase project ref (the id in the project URL). Used by `npm run db:types`
# and by the Supabase MCP server in .claude/settings.json. Must point at the DEV project.
SUPABASE_PROJECT_ID=

# Optional. PostHog project key. Analytics does nothing when empty.
NEXT_PUBLIC_POSTHOG_KEY=

# Optional. Set to "true" to force a feature to use its mock data and skip the backend.
NEXT_PUBLIC_MOCK_REPORTS=
NEXT_PUBLIC_MOCK_CLUSTERS=
NEXT_PUBLIC_MOCK_PRIORITIES=
